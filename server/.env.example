# FRD GoLive server (hub/auth/admin/config + native Go Live media). Copy to .env.
PORT=8090
# Protects the /admin/* endpoints. Generate: openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-secret

# Public URL of the control plane; empty = derive from the request host.
PUBLIC_SIGNALING_URL=

# Default quotas for new users.
DEFAULT_MAX_HEIGHT=1080
DEFAULT_MAX_FPS=30

DB_FILE=/app/data/users.json
# Directory for the guild-icon / user-avatar cache.
IMG_CACHE_DIR=/app/data/img-cache
VERSION=2.0.0

# --- Web hub (Discord login + admin panel) ---
# App at https://discord.com/developers/applications → OAuth2. Scope: identify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://stream.example.com/auth/callback
# Signs the session cookie. openssl rand -hex 32
SESSION_SECRET=change-me-session-secret
# Discord user IDs of the admins, comma-separated — they access /admin via login.
ADMIN_DISCORD_IDS=
# BOT token (the "Bot" tab of the same app) — enables "channels" mode in the
# dashboard: lists guilds/voice channels, resolves channel and member names, and via
# the GATEWAY (VOICE_STATE_UPDATE) finds the REAL channel each stream is in — which is
# what makes "disable/ban" drop whoever is live. Empty = the dashboard only works in
# login mode and "Add channel" asks for IDs.
DISCORD_BOT_TOKEN=
# Test only: point the bot gateway at a local server instead of Discord.
DISCORD_GATEWAY_URL=

# --- Native Go Live through the private server (server/src/nativeStream.ts) — THE MEDIA PATH ---
# This is where the stream video+audio flow (private, without touching Discord).
# The plugin (setting nativeStreamEndpoint = stream.example.com/dstream) redirects the
# Discord streaming connection to the WS /dstream; the native module sends the RTP to
# NATIVE_STREAM_PUBLIC_IP:NATIVE_STREAM_UDP_PORT. Empty = disabled (must be set in
# production — usually the VPS that relays the UDP; see docs/RELAY-UDP.md).
NATIVE_STREAM_PUBLIC_IP=
NATIVE_STREAM_UDP_PORT=7883
# op4 codec (H264 | H265 | VP8). Empty = follow the client's preference:
# the lowest priority with encode:true in op1 (like real Discord — e.g. H265).
NATIVE_STREAM_VIDEO_CODEC=
# op2 READY experiments (comma-separated). Real Discord sends "fixed_keyframe_interval".
NATIVE_STREAM_EXPERIMENTS=fixed_keyframe_interval
# Keyframe interval (ms) in op4. A truthy value on the client turns on the video encoder
# (keyframe_interval → setKeyframeInterval → alwaysSendVideo). Empty = omit.
NATIVE_STREAM_KEYFRAME_INTERVAL=2000
# 1 = do not request video from the sender (audio only). Keep 0 in production — native
# video works (see docs/GOLIVE-NATIVE.md).
NATIVE_STREAM_NO_VIDEO=0
# DAVE v1 (E2EE/MLS) on the stream audio. 1 = on (recommended, privacy).
# The plugin needs the nativeStreamDave setting on as well. See docs/DAVE.md.
NATIVE_STREAM_DAVE=1
# 1 = request video even without a viewer (sender-only testing).
NATIVE_STREAM_ALWAYS_WANT=1
# 1 = accept any user, without checking enablement in the hub (test only).
NATIVE_STREAM_ALLOW_ANY=0
