# Servidor FRD GoLive (hub/auth/admin/config + token do LiveKit). Copie para .env.
PORT=8090
# Protege os endpoints /admin/*. Gere: openssl rand -hex 24
ADMIN_TOKEN=troque-por-um-segredo-de-admin

# URL pública do canal de controle (policy/presença), atrás do Cloudflare.
# Vazio = deriva do host da requisição.
PUBLIC_SIGNALING_URL=

# ICE: STUN público basta para NAT amigável. TURN só para NAT simétrico/corporativo.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Quotas padrão para novos usuários.
DEFAULT_MAX_HEIGHT=1080
DEFAULT_MAX_FPS=30

DB_FILE=/app/data/users.json
VERSION=2.0.0

# --- SFU (LiveKit) — a mídia (vídeo) passa por aqui ---
# Chaves com que o servidor assina os tokens. Gere: openssl rand -hex ...
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL WS do LiveKit que o CLIENTE usa (o /config devolve como serverUrl).
# Ex.: wss://media.SEU.com  ou  ws://SEU_IP:7880
LIVEKIT_WS_URL=
# IP PÚBLICO por onde a MÍDIA (UDP 7882) entra — ex.: o VPS que faz o relay.
# O install.sh grava no livekit.yaml (node_ip). Ver docs/RELAY-UDP.md.
LIVEKIT_NODE_IP=
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
TOKEN_TTL=10m

# --- Hub web (login Discord + painel admin) ---
# App em https://discord.com/developers/applications → OAuth2. Scope: identify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://golivefrd.SEU.com/auth/callback
# Assina o cookie de sessão. openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-de-sessao
# IDs (Discord) dos admins, separados por vírgula — acessam /admin pelo login.
ADMIN_DISCORD_IDS=

# --- [Experimental] Go Live NATIVO pelo servidor privado (server/src/nativeStream.ts) ---
# O plugin (setting nativeStreamEndpoint = golivefrd.SEU.com/dstream) manda a
# conexão de transmissão do Discord para o WS /dstream; o módulo nativo envia o
# RTP para NATIVE_STREAM_PUBLIC_IP:NATIVE_STREAM_UDP_PORT. Vazio = desligado.
NATIVE_STREAM_PUBLIC_IP=
NATIVE_STREAM_UDP_PORT=7883
# Codec do op 4 (H264 | H265 | VP8). Vazio = segue a preferência do cliente:
# menor priority com encode:true no op 1 (como o Discord real — ex.: H265).
NATIVE_STREAM_VIDEO_CODEC=
# Experiments do op 2 READY (vírgula). O Discord real manda "fixed_keyframe_interval".
NATIVE_STREAM_EXPERIMENTS=fixed_keyframe_interval
# 1 = híbrido: sink want sempre 0 (vídeo nativo desligado; fica só no LiveKit).
# Para testar o vídeo NATIVO tem que ser 0 (ou ausente).
NATIVE_STREAM_NO_VIDEO=0
# 1 = DAVE v1 (E2EE/MLS), fase 1 experimental (o plugin tem a setting nativeStreamDave).
NATIVE_STREAM_DAVE=0
# 1 = pede vídeo mesmo sem espectador (teste só com quem transmite).
NATIVE_STREAM_ALWAYS_WANT=1
# 1 = aceita qualquer usuário, sem checar a habilitação no hub (só teste).
NATIVE_STREAM_ALLOW_ANY=0
