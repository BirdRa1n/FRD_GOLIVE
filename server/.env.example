# Copie para .env e troque TODOS os valores por segredos fortes e únicos.
# NÃO versione o .env (já está no .gitignore).

# Chaves da API do LiveKit. A "key" é um identificador; o "secret" é sensível.
# Gere um secret forte, ex.: openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Segredo compartilhado da organização. É o controle de acesso do MVP:
# distribua com segurança apenas aos usuários autorizados.
# Gere, ex.: openssl rand -hex 24
ORG_SECRET=troque-por-um-segredo-de-organizacao

# Validade do token emitido aos clientes.
TOKEN_TTL=10m

# URL pública do LiveKit que o PLUGIN vai usar (referência para configurar o cliente):
#   dev  -> ws://localhost:7880
#   prod -> wss://media.suaempresa.com
