# Copie para .env e troque TODOS os valores por segredos fortes e únicos.
# NÃO versione o .env (já está no .gitignore).

# Chaves da API do LiveKit. A "key" é um identificador; o "secret" é sensível.
# Gere um secret forte, ex.: openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Segredo(s) compartilhado(s) da organização — controle de acesso base.
# Rotação sem downtime: aceite uma LISTA separada por vírgula durante a troca
# (mantenha o antigo e o novo até todos migrarem), ex.: "antigo,novo".
# Gere, ex.: openssl rand -hex 24
ORG_SECRET=troque-por-um-segredo-de-organizacao

# Validade do token emitido aos clientes (mantenha curto).
TOKEN_TTL=10m

# --- Verificação de presença via bot do Discord (Fase 5, opcional) ---
# Se definido, o token-service só emite token se o usuário estiver MESMO no
# canal de voz (room). Deixe vazio para o modo só-segredo (Fase 1).
DISCORD_BOT_TOKEN=

# strict  -> exige presença confirmada; nega quando não dá pra verificar
#            (ex.: DM/grupo, ou canal em servidor onde o bot não está).
# lenient -> nega só quando o usuário comprovadamente NÃO está no canal;
#            permite quando não é verificável.
# off     -> ignora presença (equivale a não ter bot).
PRESENCE_ENFORCEMENT=strict

# --- Portas (opcional; padrões entre parênteses) ---
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
TOKEN_PORT=8080

# --- Atualização do código / painel admin (Fase UI) ---
# Repositório de onde o painel admin puxa atualizações (customizável).
UPDATE_REPO=https://github.com/BirdRa1n/FRD_GOLIVE
UPDATE_BRANCH=main
# Habilita o painel admin (/admin) — requer o override docker-compose.admin.yml.
ADMIN_UI=off
# Caminho ABSOLUTO do repo clonado no host (só necessário com ADMIN_UI=on).
HOST_REPO_DIR=

# URL pública do LiveKit que o PLUGIN vai usar (referência):
#   dev  -> ws://localhost:7880
#   prod -> wss://media.suaempresa.com
