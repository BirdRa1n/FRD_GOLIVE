{
  "name": "frd-golive-installer",
  "version": "2.0.0",
  "private": true,
  "description": "Instalador FRD GoLive — aplica a modificação no Discord (Mac/Windows).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
